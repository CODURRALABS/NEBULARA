LET G_source = "PRINT x"
LET G_src_len = 0
LET G_src_pos = 0

FUNC! test_skip_ws2:
  G_src_len = LEN(G_source)
  G_src_pos = 0
  PRINT "len=" + TO_STRING(G_src_len)
  WHILE? G_src_pos < G_src_len:
    LET c = CHAR_AT(G_source, G_src_pos)
    PRINT "ws c=" + TO_STRING(c)
    IF? c == 32:
      G_src_pos = G_src_pos + 1
    ELSE:
      PRINT "breaking"
      BREAK
    END!
  END!
  PRINT "pos=" + TO_STRING(G_src_pos)
END!

test_skip_ws2()

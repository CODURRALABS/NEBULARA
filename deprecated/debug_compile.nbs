# Helper functions
FUNC! is_alpha c:
  IF? c >= 65:
    IF? c <= 90: RETURN 1 END!
  END!
  IF? c >= 97:
    IF? c <= 122: RETURN 1 END!
  END!
  IF? c == 95: RETURN 1 END!
  IF? c == 33: RETURN 1 END!
  IF? c == 63: RETURN 1 END!
  RETURN 0
END!

FUNC! is_digit c:
  IF? c >= 48:
    IF? c <= 57: RETURN 1 END!
  END!
  RETURN 0
END!

# Entry point
PRINT "=== DEBUG: Starting ==="
LET argc = ARGUMENT_COUNT()
PRINT "argc = " + TO_STRING(argc)

IF? argc >= 4:
  LET cmd = ARGUMENT(3)
  PRINT "cmd = " + cmd
  IF? cmd == "compile":
    LET path = ARGUMENT(4)
    PRINT "path = " + path
    PRINT "=== DEBUG: Reading file ==="
    LET src = READ_FILE(path)
    PRINT "src length = " + TO_STRING(LEN(src))
    IF? LEN(src) == 0:
      PRINT "Error: cannot read " + path
    ELSE:
      PRINT "=== DEBUG: File read OK, would compile here ==="
      PRINT "First 50 chars of source:"
      PRINT SUBSTR(src, 0, MIN(50, LEN(src)))
    END!
  ELSE:
    PRINT "Usage: nebulara run compiler.nbs compile <file.nbs>"
  END!
ELSE:
  PRINT "Nebulara Self-Hosted Compiler v1.0 (DEBUG)"
  PRINT "Usage: nebulara run compiler.nbs compile <file.nbs>"
END!
PRINT "=== DEBUG: Done ==="

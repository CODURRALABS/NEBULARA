LET G_source = "PRINT x"
LET G_src_len = 0
LET G_src_pos = 0
LET G_tokens = []
LET G_token_count = 0
LET G_strings = []
LET G_string_count = 0

FUNC! is_alpha c:
  IF? c >= 65:
    IF? c <= 90: RETURN 1 END!
  END!
  IF? c >= 97:
    IF? c <= 122: RETURN 1 END!
  END!
  RETURN 0
END!

FUNC! is_digit c:
  IF? c >= 48:
    IF? c <= 57: RETURN 1 END!
  END!
  RETURN 0
END!

FUNC! add_token type val:
  LET i = G_token_count * 3
  WHILE? LEN(G_tokens) <= i + 2:
    G_tokens = G_tokens + [0]
  END!
  G_tokens[i] = type
  G_tokens[i + 1] = val
  G_tokens[i + 2] = 0
  G_token_count = G_token_count + 1
END!

FUNC! add_str_token type s:
  LET idx = G_string_count
  G_strings = G_strings + [s]
  G_string_count = G_string_count + 1
  add_token(type, idx)
END!

FUNC! read_word:
  LET start = G_src_pos
  WHILE? G_src_pos < G_src_len:
    LET c = CHAR_AT(G_source, G_src_pos)
    IF? is_alpha(c) == 1:
      G_src_pos = G_src_pos + 1
    ELSEIF? is_digit(c) == 1:
      G_src_pos = G_src_pos + 1
    ELSE:
      BREAK
    END!
  END!
  RETURN SUBSTR(G_source, start, G_src_pos - start)
END!

G_src_len = LEN(G_source)
WHILE? G_src_pos < G_src_len:
  LET c = CHAR_AT(G_source, G_src_pos)
  IF? is_digit(c) == 1:
    add_str_token(0, read_word())
  ELSEIF? is_alpha(c) == 1:
    LET word = read_word()
    IF? word == "PRINT":
      add_token(24, 0)
    ELSEIF? word == "LET":
      add_token(34, 0)
    ELSE:
      add_str_token(2, word)
    END!
  ELSEIF? c == 32:
    G_src_pos = G_src_pos + 1
  ELSE:
    G_src_pos = G_src_pos + 1
  END!
END!
PRINT "tokens=" + TO_STRING(G_token_count)
PRINT "strings=" + TO_STRING(G_string_count)

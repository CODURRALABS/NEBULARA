LET G_source = "PRINT x"
LET G_src_len = 7
LET G_src_pos = 0
LET G_tokens = []
LET G_token_count = 0

FUNC! is_alpha c:
  IF? c >= 65:
    IF? c <= 90: RETURN 1 END!
  END!
  IF? c >= 97:
    IF? c <= 122: RETURN 1 END!
  END!
  IF? c == 95: RETURN 1 END!
  RETURN 0
END!

FUNC! is_digit c:
  IF? c >= 48:
    IF? c <= 57: RETURN 1 END!
  END!
  RETURN 0
END!

FUNC! read_word:
  LET start = G_src_pos
  WHILE? G_src_pos < G_src_len:
    LET c = CHAR_AT(G_source, G_src_pos)
    IF? is_alpha(c) == 1 OR is_digit(c) == 1:
      G_src_pos = G_src_pos + 1
    ELSE:
      BREAK
    END!
  END!
  RETURN SUBSTR(G_source, start, G_src_pos - start)
END!

FUNC! tokenize:
  WHILE? G_src_pos < G_src_len:
    LET c = CHAR_AT(G_source, G_src_pos)
    IF? is_alpha(c) == 1:
      LET word = read_word()
      PRINT "word=" + word
    ELSE:
      G_src_pos = G_src_pos + 1
    END!
  END!
  PRINT "done"
END!

tokenize()
